# Foundry
out/
cache/
broadcast/

# Node
node_modules/
dist/
.next/

# Python
__pycache__/
*.pyc
.venv/

# Secrets never live in this tree. Keys for the testnet demo wallets are kept outside the
# repository; these lines are a second fence, not the first.
.env
.env.*
!.env.example
*.key
*.pem
keystore/

# Keeper progress (last block read, pools followed); local to the machine that runs it
ops/state/

# A deployment record mid-write; it replaces the record once complete
deployments/*.tmp

# macOS
.DS_Store
._*

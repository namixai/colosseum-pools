# The pool gateway on the pools host, testnet only. Installed by ops/host/install.sh; the
# layout, the users and the env files are in docs/HOSTING.md.
[Unit]
Description=colosseum-pools gateway (HyperEVM testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=colosseum-gw
Group=colosseum-gw
WorkingDirectory=/opt/colosseum-pools/current
# Addresses and paths only; the keys stay in GATEWAY_KEYS_DIR.
# The record's file last: what it says (the addresses, and the limits where the record has them) wins over a
# line by hand in gateway.env (docs/HOSTING.md, "What the record sets").
EnvironmentFile=/etc/colosseum/gateway.env
EnvironmentFile=/etc/colosseum/deployment.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/colosseum-pools/venv/bin/python -m gateway.server
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
# Not the keeper's, and not the keys of a further instance (colosseum-gateway@.service).
InaccessiblePaths=/var/lib/colosseum-keeper -/var/lib/colosseum-gw/instances
# Where pool owners' contacts are kept (gateway/contacts.py, the CTO, 28 Oct 2026): the one place this
# gateway writes. systemd makes it, the service's user's alone, and names it in $STATE_DIRECTORY; the
# faucet never takes it (gateway/faucet.py).
StateDirectory=colosseum-gw/contacts
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target

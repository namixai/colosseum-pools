# The watch of the pools host from the second machine, instance %i, run once a minute by its timer: it reads the host's
# health route (gateway/simindex.py; COLOSSEUM_HOST_HEALTH_URL, the public https address of /v1/simindex/health) and
# raises host_not_alive on THIS machine's channel (COLOSSEUM_ALERT_CMD) when the host does not answer, the stops'
# journal has not been written for 3 minutes, or the payout review has not finished a pass for 30 (ops/review_service.py
# --watch-host). Said again every hour while it lasts. Without a third-party service: the host's own channel cannot say
# that the host is down. Its file, /etc/colosseum/price-watch-%i.env, is the second writer's: COLOSSEUM_HOST_HEALTH_URL
# and COLOSSEUM_ALERT_CMD there; on mainnet it refuses to run without the channel. docs/HOSTING.md, "The second writer".
[Unit]
Description=colosseum-pools watch of the pools host %i from the second machine

[Service]
Type=oneshot
User=colosseum-prices
Group=colosseum-prices
WorkingDirectory=/opt/colosseum-pools/current
Environment=COLOSSEUM_NETWORK=testnet
EnvironmentFile=/etc/colosseum/price-watch-%i.env
Environment=COLOSSEUM_KEY_DIR=/var/lib/colosseum-prices/no-keys
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/colosseum-pools/venv/bin/python -m ops.review_service --watch-host ${COLOSSEUM_HOST_HEALTH_URL} \
    --out /var/lib/colosseum-prices --state /var/lib/colosseum-prices/host-watch-%i.json \
    --flag /var/lib/colosseum-prices/host-watch-%i.alarm
TimeoutStartSec=50
MemoryMax=256M

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/colosseum-prices
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

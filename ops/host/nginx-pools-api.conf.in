# pools-api.usenami.io: Cloudflare -> nginx :443 (Cloudflare Origin CA certificate) -> the
# gateway on 127.0.0.1:8787, plain HTTP. The host's security group lets only Cloudflare reach
# 443. Rendered by ops/host/install.sh, which puts Cloudflare's published ranges in place of
# the marker below, and only once the certificate is on the host (docs/HOSTING.md).

# Every order costs the gateway six RPC calls, and its RPC allows 1000 calls in five minutes
# per IP. Half an order a second, from everyone together, is 900 of them.
limit_req_zone $binary_remote_addr zone=pools_ip:1m rate=12r/m;
limit_req_zone $server_name zone=pools_all:1m rate=30r/m;
limit_req_status 429;

# Any other name, or none, gets no TLS handshake at all.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pools-api.usenami.io;

    ssl_certificate     /etc/colosseum/tls/origin.crt;
    ssl_certificate_key /etc/colosseum/tls/origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # The client address is the one Cloudflare saw, taken only from Cloudflare's own ranges.
@CLOUDFLARE_REAL_IP_FROM@
    real_ip_header CF-Connecting-IP;

    client_max_body_size  64k;
    client_header_timeout 10s;
    client_body_timeout   10s;
    send_timeout          15s;
    keepalive_timeout     15s;
    server_tokens         off;

    location = /v1/order {
        limit_req zone=pools_ip burst=10 nodelay;
        limit_req zone=pools_all burst=20 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location = /v1/health {
        limit_req zone=pools_ip burst=10 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location / {
        return 404;
    }
}
